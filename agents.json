{
  "_comment": "Single source for per-agent settings. prompts/<name>.md is the body. scripts/build-agents.py writes .claude/agents/<name>.md and .codex/agents/<name>.toml.",
  "agents": {
    "chief-of-staff": {
      "description": "Orchestrator: routes to the seven specialists, merges their output blocks into one ranked list, runs the daily brief and other scheduled prompts. Never touches a system directly; ledger only.",
      "tier": "route+merge",
      "claude": {
        "model": "opus",
        "tools": [
          "Agent(comms, cloud-ops, code-triage, security-watch, code-fixer, infra-builder, skills-librarian)",
          "Read",
          "Skill",
          "Bash",
          "mcp__github__*"
        ],
        "disallowedTools": [
          "Write",
          "Edit",
          "NotebookEdit",
          "mcp__github-rw__*",
          "mcp__cloudflare__*",
          "mcp__supabase__*",
          "mcp__vercel__*",
          "mcp__gmail__*",
          "mcp__slack__*",
          "mcp__google-calendar__*"
        ],
        "mcpServers": [
          "github"
        ],
        "skills": [
          "ledger",
          "routines"
        ],
        "maxTurns": 60
      },
      "codex": {
        "model": "gpt-6.1-sol",
        "model_reasoning_effort": "medium",
        "features": {
          "apps": false
        },
        "allowed_mcp": [
          "github_ro"
        ]
      }
    },
    "comms": {
      "description": "Read mail, Slack and calendar; surface what needs the operator; draft replies. Never sends. Use for pending messages, thread context, draft a reply, calendar prep.",
      "tier": "observe->propose",
      "claude": {
        "model": "sonnet",
        "tools": [
          "Read",
          "mcp__gmail__*",
          "mcp__slack__*",
          "mcp__google-calendar__*",
          "mcp__github__*"
        ],
        "disallowedTools": [
          "Write",
          "Edit",
          "Bash",
          "mcp__gmail__send_message",
          "mcp__gmail__reply",
          "mcp__gmail__forward",
          "mcp__gmail__trash_message",
          "mcp__gmail__trash_thread"
        ],
        "mcpServers": [
          "github"
        ],
        "skills": [
          "ledger"
        ],
        "maxTurns": 30
      },
      "codex": {
        "model": "gpt-6-luna",
        "model_reasoning_effort": "medium",
        "features": {
          "shell_tool": false,
          "apps": false
        },
        "allowed_mcp": [
          "github_ro"
        ]
      }
    },
