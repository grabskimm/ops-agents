# Copy to .env (git-ignored) or set as Codex Cloud / CI environment secrets. One scoped token per tier.
# GitHub fine-grained PATs
GH_TOKEN_READ=        # contents:read, actions:read, pull_requests:read, security_events:read, issues:write (ops-ledger only)
GH_TOKEN_RW=          # contents:write, pull_requests:write — scoped to the repos code-fixer / infra-builder may change
# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_PAT_RO=      # project-scoped; always used with --read-only
# Cloudflare: OAuth via mcp.cloudflare.com, or an API token with Zone:Read, Workers Scripts:Read, Firewall Services:Read, Logs:Read
CLOUDFLARE_API_TOKEN=
# Vercel: token from a read-only team member
VERCEL_TOKEN=
# Google Cloud: path to a service-account key with roles/viewer, roles/logging.viewer, roles/iam.securityReviewer
GOOGLE_APPLICATION_CREDENTIALS=
# Kubernetes: read-only kubeconfig (ClusterRole view)
KUBECONFIG=
