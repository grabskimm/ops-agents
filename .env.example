# ~/.ops-agents/.env — selectors only. No secrets: every CLI and MCP server is logged in via OAuth.
# GH_OAUTH_TOKEN is filled by install.sh from `gh auth token`; do not paste a PAT here.
GH_OAUTH_TOKEN=
GITHUB_ORGS=                     # comma-separated orgs/users the agents may read, e.g. grabskimm,lyfegame,day0-sandbox; first = default for the ledger
LEDGER_REPO=                     # owner/repo of the task ledger; default <first org>/ops-ledger
GH_ACCOUNTS=                     # optional: gh accounts to check (gh auth switch -u <user>); default = the active one
SUPABASE_PROJECT_REF=            # the project the read-only Supabase MCP points at
GCP_PROJECTS=                    # comma-separated project ids cloud-ops/security-watch may read
KUBE_CONTEXTS_RO=                # comma-separated kubeconfig contexts that are read-only (ClusterRole view); agents may use only these
KUBECONFIG=                      # optional: colon-separated list of kubeconfig files to merge
