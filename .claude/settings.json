{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Skill",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh api -X GET *)",
      "Bash(gcloud *)",
      "Bash(gcloud logging read *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(terraform init *)",
      "Bash(terraform validate*)",
      "Bash(terraform plan *)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(docker build *)",
      "Bash(python3 scripts/*)",
      "mcp__github__*",
      "mcp__cloudflare__*",
      "mcp__supabase__*",
      "mcp__vercel__*",
      "Bash(wrangler whoami*)",
      "Bash(wrangler deployments list *)",
      "Bash(wrangler tail *)",
      "Bash(wrangler kv:key list *)",
      "Bash(vercel ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(supabase projects list*)",
      "Bash(supabase functions list *)",
      "Bash(gcloud auth list*)",
      "Bash(gcloud config list*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl auth can-i *)",
      "Bash(python3 ~/.ops-agents/scripts/render-brief.py *)",
      "Bash(python3 $HOME/.ops-agents/scripts/render-brief.py *)",
      "Write(~/.ops-agents/briefs/*)",
      "Bash(open ~/.ops-agents/briefs/*)",
      "Bash(xdg-open ~/.ops-agents/briefs/*)",
      "Bash(open $HOME/.ops-agents/briefs/*)",
      "Bash(xdg-open $HOME/.ops-agents/briefs/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "mcp__github-rw__*",
      "mcp__gmail__create_draft",
      "mcp__gmail__update_draft",
      "mcp__Gmail__create_draft",
      "mcp__Gmail__update_draft",
      "mcp__Microsoft_365__outlook_create_draft",
      "mcp__Microsoft_365__outlook_create_reply_draft",
      "mcp__Microsoft_365__outlook_create_reply_all_draft",
      "mcp__Microsoft_365__outlook_update_draft"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review --approve*)",
      "Bash(gh api -X POST *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X DELETE *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(wrangler deploy *)",
      "Bash(wrangler publish *)",
      "Bash(vercel deploy *)",
      "Bash(vercel --prod*)",
      "Bash(vercel env *)",
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(gcloud * create *)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * update *)",
      "Bash(gcloud * deploy *)",
      "Bash(gcloud iam *)",
      "Bash(gcloud run deploy *)",
      "mcp__gmail__send_message",
      "mcp__gmail__reply",
      "mcp__gmail__forward",
      "mcp__gmail__trash_message",
      "mcp__gmail__trash_thread",
      "mcp__gmail__mark_message_spam",
      "mcp__gmail__mark_thread_spam",
      "Bash(supabase db reset *)",
      "Bash(supabase secrets set *)",
      "Bash(wrangler secret *)",
      "Bash(wrangler kv:key put *)",
      "Bash(wrangler d1 execute *)",
      "Bash(gcloud auth login*)",
      "Bash(gcloud config set *)",
      "Bash(kubectl config use-context *)",
      "Bash(kubectl config set-context *)",
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Gmail__mark_message_spam",
      "mcp__Gmail__mark_thread_spam",
      "mcp__Google_Calendar__create_event",
      "mcp__Google_Calendar__update_event",
      "mcp__Google_Calendar__delete_event",
      "mcp__Google_Calendar__respond_to_event",
      "mcp__google-calendar__create_event",
      "mcp__google-calendar__update_event",
      "mcp__google-calendar__delete_event",
      "mcp__google-calendar__respond_to_event",
      "mcp__Microsoft_365__outlook_send_mail",
      "mcp__Microsoft_365__outlook_send_draft",
      "mcp__Microsoft_365__outlook_forward_mail",
      "mcp__Microsoft_365__outlook_batch_delete_messages",
      "mcp__Microsoft_365__outlook_trash_thread",
      "mcp__Microsoft_365__teams_send_channel_message",
      "mcp__Microsoft_365__teams_send_chat_message",
      "mcp__Microsoft_365__teams_reply_channel_message",
      "mcp__Microsoft_365__outlook_create_event",
      "mcp__Microsoft_365__outlook_update_event",
      "mcp__Microsoft_365__outlook_delete_event",
      "mcp__Microsoft_365__outlook_respond_to_event"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/guard-observe.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/ledger-touch.sh"
          }
        ]
      }
    ]
  }
}
